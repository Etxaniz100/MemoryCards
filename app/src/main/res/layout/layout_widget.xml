<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="70dp"
    android:background="#2F104B"
    android:padding="10dp">

    <TextView
        android:id="@+id/widget_nombre_huevo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_row="0"
        android:layout_column="0"
        android:layout_alignTop="@+id/imagen_widget_estado"
        android:layout_marginStart="0dp"
        android:layout_marginTop="0dp"
        android:layout_toEndOf="@+id/imagen_widget_estado"
        android:text="Nombre?"
        android:textColor="#FFFFFF"
        android:textSize="16sp" />

    <ImageView
        android:id="@+id/imagen_widget_estado"
        android:layout_width="61dp"
        android:layout_height="60dp"
        android:layout_alignParentStart="true"
        android:layout_alignParentTop="true"
        android:layout_marginStart="0dp"
        android:layout_marginTop="0dp"
        app:srcCompat="@drawable/sentiment_satisfied_24px"
        app:tint="#FFFFFF" />

    <ImageView
        android:id="@+id/imagen_widget_actualizar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@+id/widget_nombre_huevo"
        android:layout_marginStart="5dp"
        android:layout_marginTop="4dp"
        android:layout_toEndOf="@+id/imagen_widget_estado"
        app:srcCompat="@drawable/refresh_24px"
        app:tint="#FFFFFF" />

</RelativeLayout>